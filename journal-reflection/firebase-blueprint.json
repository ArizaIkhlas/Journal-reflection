{
  "entities": {
    "User": {
      "collectionName": "users",
      "fields": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      }
    },
    "JournalEntry": {
      "collectionName": "users/{userId}/entries",
      "fields": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "reflectionAnalysis": { "type": "string" },
        "actionItems": { "type": "array" },
        "mood": { "type": "string" },
        "messages": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "userId": { "type": "string" }
      }
    }
  },
  "securityRules": {
    "users": "Allow authenticated users to read and write only their own document and subcollections under /users/{userId}/"
  }
}
