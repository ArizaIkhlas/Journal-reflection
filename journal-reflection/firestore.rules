rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-isolated collections: users can only read & write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Explicit deny for any root-level open paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
