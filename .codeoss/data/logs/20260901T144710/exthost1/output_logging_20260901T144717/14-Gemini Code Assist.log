I0901 15:24:58.180003    2481 conn_opt.go:53] jsonrpc2: --> notif: textDocument/didOpen: {"textDocument":{"uri":"file:///home/arizaikhlas01/enterprise-secure-journal/server.ts","languageId":"typescript","version":1,"text":"import express from 'express';\nimport path from 'path';\nimport dotenv from 'dotenv';\nimport { createServer as createViteServer } from 'vite';\nimport { requireFirebaseAuth } from './server/auth';\nimport { analyzeJournalEntry, enhanceJournalEntry } from './server/gemini';\nimport { getRuntimeSecret } from './server/secrets';\nimport { sanitizeInput } from './server/sanitizer';\nimport firebaseConfigJson from './firebase-applet-config.json';\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json({ limit: '2mb' }));\napp.use(express.urlencoded({ extended: true }));\n\n// --- PUBLIC HEALTH \u0026 ENVIRONMENT STATUS ---\napp.get('/api/health', async (req, res) =\u003e {\n  let secretStatus = 'pending';\n  try {\n    const sec = await getRuntimeSecret('GEMINI_API_KEY');\n    secretStatus = sec.source;\n  } catch (err: any) {\n    secretStatus = 'error_or_missing';\n  }\n\n  res.json({\n    status: 'online',\n    timestamp: Date.now(),\n    firebaseProject: firebaseConfigJson.projectId,\n    authDomain: firebaseConfigJson.authDomain,\n    firestoreDatabaseId: firebaseConfigJson.firestoreDatabaseId,\n    secretManagerIntegration: {\n      status: 'active',\n      geminiApiKeySource: secretStatus,\n    },\n    securityPolicies: {\n      jwtBearerAuth: 'enforced',\n      userIsolationScheme: '/users/{verified_uid}/journal_entries/{doc_id}',\n      inputSanitization: 'active',\n      structuredJsonSchema: 'active',\n    },\n  });\n});\n\n// --- SECURE ROUTE: AUDIT \u0026 VERIFY IDENTITY BOUNDARY ---\napp.post('/api/security/verify', requireFirebaseAuth, (req, res) =\u003e {\n  // Direct proof of requirement: Extract identity strictly from verified token, ignore any client-supplied userId\n  const verifiedUid = req.user!.uid;\n  const attemptedClientSpoof = req.body?.userId;\n\n  res.json({\n    verified: true,\n    tokenIdentity: {\n      uid: verifiedUid,\n      email: req.user!.email || null,\n      isAnonymous: req.user!.isAnonymous || false,\n      authTime: req.user!.authTime,\n    },\n    isolationCheck: {\n      clientSuppliedUid: attemptedClientSpoof || null,\n      enforcedServerUid: verifiedUid,\n      spoofDetected: attemptedClientSpoof \u0026\u0026 attemptedClientSpoof !== verifiedUid,\n      authorizedFirestorePath: `/users/${verifiedUid}/journal_entries`,\n      securityRuleMatch: `request.auth.uid == '${verifiedUid}'`,\n    },\n    timestamp: Date.now(),\n  });\n});\n\n// --- SECURE ROUTE: AI REFLECTION \u0026 ANALYSIS ---\napp.post('/api/journal/analyze', requireFirebaseAuth, async (req, res) =\u003e {\n  try {\n    const verifiedUid = req.user!.uid; // Strictly verified UID from JWT Bearer token\n    const { content, title } = req.body;\n\n    if (!content || typeof content !== 'string' || content.trim().length === 0) {\n      res.status(400).json({ error: 'Journal content is required for analysis.' });\n      return;\n    }\n\n    // Process with strict input sanitization, Secret Manager runtime key, and Gemini Structured JSON output\n    const { analysis, sanitization, secretSource } = await analyzeJournalEntry(content, title);\n\n    res.json({\n      success: true,\n      verifiedUid,\n      userScopedPath: `/users/${verifiedUid}/journal_entries`,\n      analysis,\n      sanitizationReport: {\n        originalLength: sanitization.charCountOriginal,\n        sanitizedLength: sanitization.charCountSanitized,\n        threatsNeutralized: sanitization.threatsNeutralized,\n        detectedSensitivities: sanitization.detectedSensitivities,\n        riskScore: sanitization.riskScore,\n      },\n      secretManagerSource: secretSource,\n    });\n  } catch (error: any) {\n    console.error('AI Analysis Error:', error);\n    res.status(500).json({\n      error: 'Failed to complete AI journal analysis.',\n      details: error.message,\n    });\n  }\n});\n\n// --- SECURE ROUTE: AI WRITING ENHANCEMENT ---\napp.post('/api/journal/enhance', requireFirebaseAuth, async (req, res) =\u003e {\n  try {\n    const verifiedUid = req.user!.uid;\n    const { content, title, style = 'executive' } = req.body;\n\n    if (!content || typeof content !== 'string') {\n      res.status(400).json({ error: 'Content is required.' });\n      return;\n    }\n\n    const validStyles = ['executive', 'reflective', 'concise', 'strategic'] as const;\n    const chosenStyle = validStyles.includes(style) ? style : 'executive';\n\n    const result = await enhanceJournalEntry(content, chosenStyle, title);\n\n    res.json({\n      success: true,\n      verifiedUid,\n      style: chosenStyle,\n      enhancedData: result.data,\n      sanitizationReport: {\n        originalLength: result.sanitization.charCountOriginal,\n        sanitizedLength: result.sanitization.charCountSanitized,\n        threatsNeutralized: result.sanitization.threatsNeutralized,\n      },\n      secretManagerSource: result.secretSource,\n    });\n  } catch (error: any) {\n    console.error('AI Enhancement Error:', error);\n    res.status(500).json({\n      error: 'Failed to enhance journal entry.',\n      details: error.message,\n    });\n  }\n});\n\n// --- SECURE ROUTE: INPUT SANITIZATION TEST BENCH ---\napp.post('/api/security/sanitize-preview', (req, res) =\u003e {\n  const { input } = req.body;\n  const report = sanitizeInput(input);\n  res.json({ report });\n});\n\n// --- VITE DEV / PRODUCTION STATIC SERVING ---\nasync function startServer() {\n  if (process.env.NODE_ENV !== 'production') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: 'spa',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), 'dist');\n    app.use(express.static(distPath));\n    app.get('*', (req, res) =\u003e {\n      res.sendFile(path.join(distPath, 'index.html'));\n    });\n  }\n\n  app.listen(PORT, '0.0.0.0', () =\u003e {\n    console.log(`Enterprise Secure Journal Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"}}
