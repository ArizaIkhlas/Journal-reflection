Listen to Firebase Auth state changes\n  useEffect(() =\u003e {\n    const unsubscribe = subscribeToAuthState((user: User | null) =\u003e {\n      if (user) {\n        setCurrentUser(formatUserProfile(user));\n      } else {\n        setCurrentUser(null);\n      }\n      setLoadingAuth(false);\n    });\n\n    return () =\u003e unsubscribe();\n  }, []);\n\n  // Listen to user-scoped Firestore entries\n  useEffect(() =\u003e {\n    if (!currentUser) {\n      setEntries([]);\n      return;\n    }\n\n    setFirestoreError(null);\n    const unsubscribe = subscribeToUserEntries(\n      currentUser.uid,\n      (fetchedEntries) =\u003e {\n        setEntries(fetchedEntries);\n        // If an entry was selected, keep it updated\n        if (selectedEntry) {\n          const matched = fetchedEntries.find((e) =\u003e e.id === selectedEntry.id);\n          if (matched) {\n            setSelectedEntry(matched);\n          }\n        }\n      },\n      (err) =\u003e {\n        setFirestoreError(err.message);\n      }\n    );\n\n    return () =\u003e unsubscribe();\n  }, [currentUser?.uid]);\n\n  const handleSaveEntry = async (\n    entryData: Partial\u003cJournalEntry\u003e \u0026 { title: string; content: string }\n  ) =\u003e {\n    if (!currentUser) {\n      setAuthModalOpen(true);\n      return;\n    }\n\n    const docId = await saveUserJournalEntry(currentUser.uid, entryData);\n    setIsEditing(false);\n    setEditingEntry(null);\n\n    // If saving from editor, select the newly saved/updated entry\n    const updated = entries.find((e) =\u003e e.id === docId);\n    if (updated) {\n      setSelectedEntry(updated);\n    }\n  };\n\n  const handleDeleteEntry = async (id: string) =\u003e {\n    if (!currentUser) return;\n    await deleteUserJournalEntry(currentUser.uid, id);\n    if (selectedEntry?.id === id) {\n      setSelectedEntry(null);\n    }\n  };\n\n  const handleStartNewEntry = () =\u003e {\n    if (!currentUser) {\n      setAuthModalOpen(true);\n      return;\n    }\n    setEditingEntry(null);\n    setSelectedEntry(null);\n    setIsEditing(true);\n    setActiveTab('journal');\n  };\n\n  const handleEditEntry = (entry: JournalEntry) =\u003e {\n    setEditingEntry(entry);\n    setSelectedEntry(null);\n    setIsEditing(true);\n  };\n\n  const handleGoogleSignIn = async () =\u003e {\n    try {\n      setAuthLoading(true);\n      setAuthError(null);\n      await signInGoogle();\n    } catch (err: any) {\n      setAuthError(formatAuthError(err));\n    } finally {\n      setAuthLoading(false);\n    }\n  };\n\n  const handleGuestSignIn = async () =\u003e {\n    try {\n      setAuthLoading(true);\n      setAuthError(null);\n      await signInGuest();\n    } catch (err: any) {\n      setAuthError(formatAuthError(err));\n    } finally {\n      setAuthLoading(false);\n    }\n  };\n\n  if (loadingAuth) {\n    return (\n      \u003cdiv className=\"flex min-h-screen items-center justify-center bg-[#0A0A0B] text-slate-300\"\u003e\n        \u003cdiv className=\"flex flex-col items-center gap-3\"\u003e\n          \u003cdiv className=\"flex h-12 w-12 items-center justify-center rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400\"\u003e\n            \u003cdiv className=\"w-2.5 h-2.5 bg-emerald-400 rounded-full shadow-[0_0_8px_rgba(52,211,153,0.6)] animate-pulse\" /\u003e\n          \u003c/div\u003e\n          \u003cp className=\"font-mono text-xs text-slate-400 uppercase tracking-wider\"\u003e\n            Initializing Protected Identity Session...\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    );\n  }\n\n  return (\n    \u003cdiv className=\"min-h-screen bg-[#0A0A0B] text-slate-300 flex flex-col font-sans selection:bg-emerald-500/30 selection:text-emerald-300\"\u003e\n      \n      {/* Navigation Header */}\n      \u003cNavbar\n        user={currentUser}\n        activeTab={activeTab}\n        onTabChange={(tab) =\u003e {\n          setActiveTab(tab);\n          if (tab !== 'journal') {\n    